# =================================================================
# SecOps Sentinel — Örnek Ortam Değişkenleri (.env.example)
# =================================================================
# Canlıya alırken bu dosyayı '.env' olarak kopyalayıp değerleri doldurun.

# Ortam & Veritabanı
ENV=development
DATABASE_URL=sqlite:///./secops_sentinel.db
# PostgreSQL için:
# DATABASE_URL=postgresql://secops_user:secops_pass@localhost:5432/secops_sentinel

# CORS İzinleri (Virgülle ayrılmış veya JSON liste)
ALLOWED_ORIGINS=*

# JWT Güvenliği (Canlı ortamda güçlü rastgele bir anahtar ile değiştirin)
SECRET_KEY=secops-sentinel-ultra-secure-jwt-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# E-posta & SMTP Alarm Bildirimleri (Opsiyonel)
EMAIL_ALERTS_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_SSL=false
ALERT_EMAIL_FROM=secops-sentinel@security.local
ALERT_EMAIL_TO=soc-team@security.local
ALERT_MIN_SEVERITY=HIGH

# Webhook Bildirimleri (Slack / Discord / Teams) (Opsiyonel)
WEBHOOK_URL=
